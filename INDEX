  $('#page').innerHTML=(renderers[state.view]||renderDashboard)();
}
function changeView(view){if(!NAV.some(x=>x[0]===view))return;state.view=view;state.card=0;state.flipped=false;state.page=0;state.search='';state.quiz=null;$('#sidebar').classList.remove('open');render();if(view==='learn'||view==='flashcards')autoSpeak(currentWord());window.scrollTo({top:0,behavior:'smooth'});}
function selectScope(t,p){state.test=Math.max(1,Math.min(10,t));state.part=Math.max(1,Math.min(6,p));state.lesson=0;state.card=0;state.flipped=false;state.quiz=null;state.search='';state.page=0;render();if(state.view==='learn'||state.view==='flashcards')autoSpeak(currentWord());}
function moveCard(direction){const next=state.card+direction,a=lessonWords();if(next<0||next>=a.length)return;state.card=next;state.flipped=false;render();autoSpeak(currentWord());}
function moveLesson(direction){const next=state.lesson+direction;if(next<0||next>=lessons())return;state.lesson=next;state.card=0;state.flipped=false;state.quiz=null;render();if(state.view==='learn'||state.view==='flashcards')autoSpeak(currentWord());}
function movePage(direction){const pages=Math.max(1,Math.ceil(sourceList().length/25));state.page=Math.max(0,Math.min(pages-1,state.page+direction));$('#wordResults').innerHTML=listBodyHTML();}
function exportProgress(){const payload={app:'VocaStep',version:2,exportedAt:new Date().toISOString(),statuses:progress.statuses,correctCounts:progress.correctCounts,learnedAt:progress.learnedAt,results:progress.results,prefs};const blob=new Blob([JSON.stringify(payload,null,2)],{type:'application/json'});const url=URL.createObjectURL(blob),a=document.createElement('a');a.href=url;a.download='VocaStep_tien_do_'+today()+'.json';a.click();setTimeout(()=>URL.revokeObjectURL(url),3000);toast('Đã tải bản sao tiến độ học của bạn.');}
function importProgress(file){if(!file)return;const r=new FileReader();r.onload=()=>{try{
  const p=JSON.parse(r.result);if(p.app!=='VocaStep'||!p.statuses||typeof p.statuses!=='object')throw new Error('Invalid progress');
  const fromOld=Number(p.version)!==2;
  progress=normalizeProgress(p);
  if(p.prefs&&typeof p.prefs==='object'){prefs.voice=['en-US','en-GB'].includes(p.prefs.voice)?p.prefs.voice:'en-US';prefs.speed=[0.65,0.8,1,1.15].includes(Number(p.prefs.speed))?Number(p.prefs.speed):0.8;prefs.auto=Boolean(p.prefs.auto);savePrefs();}
  saved();render();toast(fromOld?'Đã nhập tiến độ cũ. Các từ cần luyện đúng 5 lần mới được tính Đã thuộc.':'Đã khôi phục số lần đúng và tiến độ 5/5 của từng từ.');
 }catch(_){toast('Tệp tiến độ không hợp lệ. Hãy chọn tệp JSON được xuất từ VocaStep.');}
};r.readAsText(file,'UTF-8');}

document.addEventListener('click',e=>{const btn=e.target.closest('button,[role=button]');if(!btn||btn.disabled)return;
  if(btn.dataset.speak){e.stopPropagation();speak(btn.dataset.speak);return;}
  if(btn.dataset.mark){if(btn.dataset.mark==='review')toggleReview(btn.dataset.id);return;}
  if(btn.dataset.chooseTest){selectScope(Number(btn.dataset.chooseTest),1);return;}
  if(btn.dataset.choosePart){selectScope(state.test,Number(btn.dataset.choosePart));changeView('learn');return;}
  if(btn.dataset.view){changeView(btn.dataset.view);return;}
  if(btn.dataset.cardDir){moveCard(Number(btn.dataset.cardDir));return;}
  if(btn.dataset.lessonDir){moveLesson(Number(btn.dataset.lessonDir));return;}
  if(btn.dataset.pageDir){movePage(Number(btn.dataset.pageDir));return;}
  if(btn.dataset.quizKind){state.quizKind=btn.dataset.quizKind;state.quiz=null;render();return;}
  if(btn.dataset.choice!==undefined){const q=state.quiz;if(!q||q.answered)return;const w=q.items[q.index];q.selected=q.options[Number(btn.dataset.choice)];recordQuizAnswer(q.selected===w.vi);render();return;}
  const act=btn.dataset.action;
  if(act==='menu'){$('#sidebar').classList.toggle('open');return;}
  if(act==='flip'){state.flipped=!state.flipped;render();return;}
  if(act==='next-question'){const q=state.quiz;if(!q||!q.answered)return;if(q.index===q.items.length-1){finishQuiz();}else{q.index++;q.answered=false;q.selected=null;q.correctTyping=false;q.answerText='';q.options=createOptions(q.items[q.index]);}render();if(state.quizKind==='listen'&&!q.finished)autoSpeak(q.items[q.index]);return;}
  if(act==='restart-quiz'){state.quiz=null;render();return;}
  if(act==='export'){exportProgress();return;}
  if(act==='import'){$('#importProgress').click();return;}
});
document.addEventListener('change',e=>{const id=e.target.id;if(id==='testSelect')selectScope(Number(e.target.value),state.part);if(id==='partSelect')selectScope(state.test,Number(e.target.value));if(id==='voiceSelect'){prefs.voice=e.target.value;savePrefs();toast('Đã chọn giọng đọc mới.');}if(id==='speedSelect'){prefs.speed=Number(e.target.value);savePrefs();toast('Đã thay đổi tốc độ phát âm.');}if(id==='statusFilter'){state.statusFilter=e.target.value;state.page=0;$('#wordResults').innerHTML=listBodyHTML();}if(id==='listScope'){state.listScope=e.target.value;state.page=0;$('#wordResults').innerHTML=listBodyHTML();}if(id==='autoRead'){prefs.auto=e.target.checked;savePrefs();toast(prefs.auto?'Đã bật tự động đọc khi chuyển từ.':'Đã tắt tự động đọc.');}if(id==='importProgress'){importProgress(e.target.files[0]);e.target.value='';}});
document.addEventListener('input',e=>{if(e.target.id==='searchInput'){state.search=e.target.value;state.page=0;$('#wordResults').innerHTML=listBodyHTML();}});
document.addEventListener('submit',e=>{if(e.target.id==='typingForm'){e.preventDefault();submitTyping();}});
document.addEventListener('keydown',e=>{const target=e.target;const isTyping=/INPUT|TEXTAREA|SELECT/.test(target.tagName);if(isTyping)return;if((state.view==='learn'||state.view==='flashcards')&&e.key==='ArrowRight'){e.preventDefault();moveCard(1);}else if((state.view==='learn'||state.view==='flashcards')&&e.key==='ArrowLeft'){e.preventDefault();moveCard(-1);}else if((state.view==='learn'||state.view==='flashcards')&&e.code==='Space'){e.preventDefault();speak(currentWord().id);}else if(state.view==='flashcards'&&(e.key==='Enter'||e.key.toLowerCase()==='f')){e.preventDefault();state.flipped=!state.flipped;render();}});
$('#testSelect').innerHTML=Array.from({length:10},(_,i)=>`<option value="${i+1}">TEST ${i+1}</option>`).join('');
$('#partSelect').innerHTML=Array.from({length:6},(_,i)=>`<option value="${i+1}">PART ${i+1}</option>`).join('');
render();
if(upgradingLegacy)setTimeout(()=>toast('Đã đổi sang quy tắc 5 lượt đúng. Dấu Đã thuộc cũ cần được kiểm tra lại để tính chính xác.'),1000);
</script>
</body>
</html>
