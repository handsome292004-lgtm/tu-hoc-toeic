pos":"n+v","row":165},{"id":"t10-p6-r166","test":10,"part":6,"en":"advance","vi":"tiến lên, tiến tới, tiến bộ | sự tiến lên, sự tiến tới, sự tiến bộ","ipa":"/ədˈvɑːns/","pos":"adj","row":166},{"id":"t10-p6-r167","test":10,"part":6,"en":"advancement","vi":"sự tiến lên, sự tiến tới, sự tiến bộ","ipa":"/ədˈvɑːnsmənt/","pos":"n","row":167},{"id":"t10-p6-r168","test":10,"part":6,"en":"issue","vi":"số báo (in ra)","ipa":"/ˈɪʃuː/","pos":"n","row":168},{"id":"t10-p6-r169","test":10,"part":6,"en":"background","vi":"kinh nghiệm, quá trình học hành","ipa":"/ˈbækɡraʊnd/","pos":"n","row":169},{"id":"t10-p6-r170","test":10,"part":6,"en":"eligible","vi":"đủ tư cách, thích hợp","ipa":"/ˈelɪdʒəbl/","pos":"adj","row":170},{"id":"t10-p6-r171","test":10,"part":6,"en":"clinic","vi":"bệnh xá, phòng khám tư","ipa":"/ˈklɪnɪk/","pos":"n","row":171},{"id":"t10-p6-r172","test":10,"part":6,"en":"dental","vi":"(thuộc) răng","ipa":"/ˈdentl/","pos":"adj","row":172},{"id":"t10-p6-r173","test":10,"part":6,"en":"exceptional","vi":"khác thường, đặc biệt, hiếm có","ipa":"/ɪkˈsepʃənl/","pos":"adj","row":173},{"id":"t10-p6-r174","test":10,"part":6,"en":"rich","vi":"giàu, giàu có, có nhiều tiền, có của cải","ipa":"/rɪtʃ/","pos":"adj","row":174},{"id":"t10-p6-r175","test":10,"part":6,"en":"vibrant","vi":"sôi nổi, mạnh mẽ, đầy hứng thú","ipa":"/ˈvaɪbrənt/","pos":"adj","row":175},{"id":"t10-p6-r176","test":10,"part":6,"en":"interest","vi":"mối quan tâm, sự quan tâm | làm cho quan tâm","ipa":"/ˈɪntrəst/","pos":"n + v","row":176},{"id":"t10-p6-r177","test":10,"part":6,"en":"administrative","vi":"(thuộc) hành chính, (thuộc) quản trị","ipa":"/ədˈmɪnɪstrətɪv/","pos":"adj","row":177},{"id":"t10-p6-r178","test":10,"part":6,"en":"ambitious","vi":"có nhiều tham vọng, có nhiều khát vọng","ipa":"/æmˈbɪʃəs/","pos":"adj","row":178},{"id":"t10-p6-r179","test":10,"part":6,"en":"networking event","vi":"sự kiện kết nối doanh nghiệp","ipa":"/ˈnetwɜːkɪŋ ɪˈvent/","pos":"noun phrase","row":179},{"id":"t10-p6-r180","test":10,"part":6,"en":"analysis","vi":"sự phân tích, phép phân tích","ipa":"/əˈnæləsɪs/","pos":"n","row":180},{"id":"t10-p6-r181","test":10,"part":6,"en":"kiosk","vi":"buồng","ipa":"/ˈkiːɒsk/","pos":"n","row":181},{"id":"t10-p6-r182","test":10,"part":6,"en":"passenger","vi":"người hành khách","ipa":"/ˈpæsɪndʒə(r)/","pos":"n","row":182},{"id":"t10-p6-r183","test":10,"part":6,"en":"boarding pass","vi":"thẻ lên máy bay","ipa":"/ˈbɔːdɪŋ pɑːs/","pos":"noun phrase","row":183},{"id":"t10-p6-r184","test":10,"part":6,"en":"tag","vi":"buộc thẻ ghi địa chỉ vào","ipa":"/tæɡ/","pos":"v","row":184},{"id":"t10-p6-r185","test":10,"part":6,"en":"load","vi":"chất, chở, nhét, nhồi, tống vào","ipa":"/ləʊd/","pos":"v","row":185},{"id":"t10-p6-r186","test":10,"part":6,"en":"aircraft","vi":"khí cụ bay","ipa":"/ˈeəkrɑːft/","pos":"n","row":186},{"id":"t10-p6-r187","test":10,"part":6,"en":"route","vi":"tuyến đường","ipa":"/ruːt/","pos":"n","row":187},{"id":"t10-p6-r188","test":10,"part":6,"en":"peak","vi":"đỉnh, đột điểm","ipa":"/piːk/","pos":"adj","row":188}]}</script>
<script>
'use strict';
const DB=JSON.parse(document.getElementById('vocabData').textContent);
const ALL=DB.entries;
const BY_ID=new Map(ALL.map(w=>[w.id,w]));
const COUNT=ALL.length;
const STORAGE='vocaStep-progress-v1';
const PREFS='vocaStep-prefs-v1';
const NAV=[['dashboard','⌂','Tổng quan'],['learn','📖','Học từng từ'],['flashcards','▣','Thẻ ghi nhớ'],['quiz','✓','Kiểm tra'],['words','☷','Danh sách từ'],['review','↻','Cần ôn tập']];
const ICONS=['📸','💬','🧩','📄','📚','🎧'];
const today=()=>new Date().toLocaleDateString('sv-SE');
function loadJSON(key,def){try{const v=JSON.parse(localStorage.getItem(key));return v&&typeof v==='object'?v:def;}catch(_){return def;}}
// V2: mỗi từ cần 5 lượt trả lời đúng được ghi nhận tự động, xuyên suốt các bài kiểm tra.
// Các trạng thái 'known' cũ chỉ là tự đánh dấu, KHÔNG được quy đổi thành 5 đáp án đúng.
const REQUIRED_CORRECT=5;
const QUIZ_KINDS=['meaning','listen','spell'];
function normalizeProgress(raw){
 const p=raw&&typeof raw==='object'?raw:{};
 const wasOld=Number(p.version)!==2;
 const statuses={};
 for(const [id,v] of Object.entries(p.statuses&&typeof p.statuses==='object'?p.statuses:{})){
   if(!BY_ID.has(id))continue;
   if(v==='review'||(wasOld&&v==='known'))statuses[id]='review';
 }
 const correctCounts={};
 if(!wasOld&&p.correctCounts&&typeof p.correctCounts==='object'){
   for(const [id,c] of Object.entries(p.correctCounts)){
     if(!BY_ID.has(id)||!c||typeof c!=='object')continue;
     const valid={};
     for(const k of QUIZ_KINDS){const n=Number(c[k]);valid[k]=Number.isFinite(n)?Math.max(0,Math.min(REQUIRED_CORRECT,Math.floor(n))):0;}
     if(QUIZ_KINDS.some(k=>valid[k]>0))correctCounts[id]=valid;
   }
 }
 const learnedAt={};
 if(!wasOld&&p.learnedAt&&typeof p.learnedAt==='object'){
   for(const [id,d] of Object.entries(p.learnedAt)){
     if(BY_ID.has(id)&&typeof d==='string'&&correctCounts[id]&&QUIZ_KINDS.reduce((sum,k)=>sum+correctCounts[id][k],0)>=REQUIRED_CORRECT)learnedAt[id]=d;
   }
 }
 return {version:2,statuses,correctCounts,learnedAt,results:Array.isArray(p.results)?p.results.slice(-100):[]};
}
const legacyData=loadJSON(STORAGE,{});
const upgradingLegacy=Number(legacyData.version)!==2&&Object.keys(legacyData.statuses||{}).length>0;
let progress=normalizeProgress(legacyData);
if(upgradingLegacy){try{localStorage.setItem(STORAGE,JSON.stringify(progress));}catch(_){}}
let prefs=loadJSON(PREFS,{voice:'en-US',speed:0.8,auto:false});
let state={view:'dashboard',test:1,part:1,lesson:0,card:0,flipped:false,search:'',statusFilter:'all',listScope:'all',page:0,quizKind:'meaning',quiz:null};
let speakingId=null;
let toastTimer=null;
const $=s=>document.querySelector(s);
const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
function saved(){try{localStorage.setItem(STORAGE,JSON.stringify(progress));}catch(_){toast('Trình duyệt không cho phép lưu. Bạn có thể xuất dữ liệu học để sao lưu.');}}
function savePrefs(){try{localStorage.setItem(PREFS,JSON.stringify(prefs));}catch(_){}}
function toast(msg){const el=$('#toast');el.textContent=msg;el.classList.add('visible');clearTimeout(toastTimer);toastTimer=setTimeout(()=>el.classList.remove('visible'),3300);}
function correctParts(w){const id=typeof w==='string'?w:w.id;const a=progress.correctCounts[id]||{};return {meaning:a.meaning||0,listen:a.listen||0,spell:a.spell||0};}
function correctTotal(w){const x=correctParts(w);return Math.min(REQUIRED_CORRECT,x.meaning+x.listen+x.spell);}
function getStatus(w){const id=typeof w==='string'?w:w.id;if(correctTotal(id)>=REQUIRED_CORRECT)return 'known';if(progress.statuses[id]==='review')return 'review';return correctTotal(id)>0?'learning':'new';}
const knownNum=(items=ALL)=>items.reduce((n,w)=>n+(getStatus(w)==='known'),0);
const reviewNum=(items=ALL)=>items.reduce((n,w)=>n+(getStatus(w)==='review'),0);
const learningNum=(items=ALL)=>items.reduce((n,w)=>n+(getStatus(w)==='learning'),0);
const percentage=items=>items.length?Math.round(100*knownNum(items)/items.length):0;
function toggleReview(id){if(!BY_ID.has(id))return;if(getStatus(id)==='known'){toast('Từ này đã đạt 5/5. Nếu muốn ôn thêm, hãy vào bài Kiểm tra.');return;}if(progress.statuses[id]==='review')delete progress.statuses[id];else progress.statuses[id]='review';saved();render();}
function creditCorrect(id,kind){if(!BY_ID.has(id)||!QUIZ_KINDS.includes(kind))return false;const before=correctTotal(id);if(before>=REQUIRED_CORRECT)return false;const counts=correctParts(id);counts[kind]+=1;progress.correctCounts[id]=counts;if(correctTotal(id)>=REQUIRED_CORRECT){progress.learnedAt[id]=today();delete progress.statuses[id];}saved();return before<REQUIRED_CORRECT&&correctTotal(id)>=REQUIRED_CORRECT;}
function masteryHTML(w){const n=correctTotal(w),a=correctParts(w);return `<div class="mastery-info">${n===REQUIRED_CORRECT?'🎉 Đạt chuẩn đã thuộc':'Tiến độ ghi nhớ'}: <b>${n}/${REQUIRED_CORRECT} lần đúng</b></div><div class="mastery-track" role="progressbar" aria-valuemin="0" aria-valuemax="5" aria-valuenow="${n}" aria-label="Số lần trả lời đúng"><i style="width:${n/REQUIRED_CORRECT*100}%"></i></div><div class="helper" style="margin-top:7px">Chọn nghĩa: ${a.meaning} · Nghe chọn nghĩa: ${a.listen} · Gõ đúng: ${a.spell}</div>`;}

const testWords=t=>ALL.filter(w=>w.test===t);
const partWords=(t,p)=>ALL.filter(w=>w.test===t&&w.part===p);
const scopeWords=()=>partWords(state.test,state.part);
const lessonSize=10;
function lessons(){return Math.max(1,Math.ceil(scopeWords().length/lessonSize));}
function lessonWords(){state.lesson=Math.min(Math.max(state.lesson,0),lessons()-1);return scopeWords().slice(state.lesson*lessonSize,(state.lesson+1)*lessonSize);}
function currentWord(){const a=lessonWords();state.card=Math.min(Math.max(state.card,0),Math.max(0,a.length-1));return a[state.card]||null;}
function cleanForSpeech(w){return w.replace(/\([^)]*\)/g,' ').replace(/\s*[-–]+\s*/g,' ').replace(/[\[\]]/g,'').replace(/\s+/g,' ').trim();}
function speak(id){const w=BY_ID.get(id);if(!w)return;if(!('speechSynthesis' in window)||!('SpeechSynthesisUtterance' in window)){toast('Trình duyệt chưa hỗ trợ đọc tiếng Anh. Hãy dùng Chrome hoặc Edge.');return;}
  const t=cleanForSpeech(w.en);if(!t)return;
  window.speechSynthesis.cancel();const u=new SpeechSynthesisUtterance(t);u.lang=prefs.voice||'en-US';u.rate=Number(prefs.speed)||0.8;u.pitch=1;u.volume=1;
  const voices=window.speechSynthesis.getVoices();const english=voices.filter(v=>v.lang&&v.lang.toLowerCase().startsWith('en'));
  const target=english.find(v=>v.lang.toLowerCase()===u.lang.toLowerCase())||english.find(v=>v.lang.toLowerCase().startsWith(u.lang.toLowerCase().split('-')[0]))||null;
  if(target)u.voice=target;
  u.onstart=()=>{speakingId=id;document.querySelectorAll('[data-speak]').forEach(b=>b.classList.toggle('speaking',b.dataset.speak===id));};
  u.onend=()=>{if(speakingId===id)speakingId=null;document.querySelectorAll('.speaking').forEach(b=>b.classList.remove('speaking'));};
  u.onerror=e=>{if(e.error!=='interrupted'&&e.error!=='canceled')toast('Không phát được giọng đọc. Hãy kiểm tra cài đặt giọng nói tiếng Anh của thiết bị.');};
  window.speechSynthesis.speak(u);
}
function autoSpeak(w){if(prefs.auto&&w)speak(w.id);}
function navHTML(){return NAV.map(([v,i,t])=>`<button type="button" class="nav-button ${state.view===v?'active':''}" data-view="${v}"><span class="nav-icon">${i}</span><span>${t}</span></button>`).join('');}
function headerHTML(label,sub){return `<div class="page-head"><div><span class="kicker">✦ VocaStep · TEST ${state.test} / PART ${state.part}</span><h1>${label}</h1><p>${sub}</p></div></div>`;}
function statusPill(w){const v=getStatus(w);return `<span class="pill ${v}">${v==='known'?'✓ Đã thuộc (5/5)':v==='review'?`↻ Cần ôn (${correctTotal(w)}/5)`:v==='learning'?`◔ Đang học (${correctTotal(w)}/5)`:'○ Chưa học (0/5)'}</span>`;}
function stripHTML(){const words=lessonWords(),total=scopeWords().length;return `<div class="lesson-strip"><div><div class="strip-info"><b>TEST ${state.test} · PART ${state.part}</b> &nbsp;·&nbsp; ${total} từ</div><div class="helper">Bài nhỏ ${state.lesson+1}/${lessons()} · Từ ${state.lesson*10+1}–${state.lesson*10+words.length}</div></div><div class="lesson-actions"><button class="mini" data-lesson-dir="-1" ${state.lesson===0?'disabled':''}>← Bài trước</button><button class="mini" data-lesson-dir="1" ${state.lesson>=lessons()-1?'disabled':''}>Bài sau →</button></div></div>`;}
function miniStats(){const a=scopeWords();return `<div class="panel"><h3>Tiến độ Part này</h3><div class="stats-line"><span>Đã thuộc</span><b>${knownNum(a)} / ${a.length}</b></div><div class="mini-progress"><i style="width:${percentage(a)}%"></i></div><div class="stats-line"><span>Cần ôn lại</span><b>${reviewNum(a)} từ</b></div><div class="stats-line"><span>Đang học (1–4/5)</span><b>${learningNum(a)} từ</b></div><div class="stats-line"><span>Chưa học (0/5)</span><b>${a.length-knownNum(a)-reviewNum(a)-learningNum(a)} từ</b></div></div>`;}
function tipPanel(){return `<div class="panel"><h3>💡 Mẹo cho người mới</h3><p>1. Nhấn 🔊 và nghe mỗi từ 2–3 lần.</p><p>2. Nhìn từ, đọc theo thành tiếng.</p><p>3. Che nghĩa và thử nhớ lại.</p><p>4. Làm đúng tổng cộng <b>5 lần</b> (nhìn từ/chọn nghĩa, nghe/chọn nghĩa, gõ từ) để tự động đạt “Đã thuộc”.</p><p>5. Bấm <b>Cần ôn</b> nếu muốn đánh dấu từ khó; nút này không cộng lần đúng.</p><label style="display:flex;gap:9px;align-items:center;font-size:12px;color:#536381;margin-top:12px"><input type="checkbox" id="autoRead" ${prefs.auto?'checked':''}> Tự đọc khi chuyển sang từ mới</label></div>`;}
function renderDashboard(){const done=knownNum(),review=reviewNum(),learnedToday=Object.entries(progress.learnedAt).filter(([id,d])=>d===today()&&getStatus(id)==='known').length;
