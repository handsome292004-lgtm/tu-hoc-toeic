  <div class="two-columns"><div class="panel"><h2 class="section-title">Lộ trình học gợi ý · 15 phút/ngày</h2><ul class="checklist"><li><span class="checkmark">1</span><span><b>5 phút:</b> học 10 từ mới, nghe từng từ chậm và đọc theo.</span></li><li><span class="checkmark">2</span><span><b>5 phút:</b> dùng flashcard che nghĩa, thử đoán trước khi lật.</span></li><li><span class="checkmark">3</span><span><b>5 phút:</b> làm trắc nghiệm, ôn lại các từ trả lời sai.</span></li></ul></div><div class="panel"><h2 class="section-title">Tiến độ của bạn</h2><p style="color:var(--muted);font-size:13px">Bạn đã đạt chuẩn 5 lần đúng với ${done} trên ${COUNT.toLocaleString('vi-VN')} mục từ.</p><div class="mini-progress"><i style="width:${percentage(ALL)}%"></i></div><div class="action-row" style="margin-top:19px"><button class="secondary" data-action="export">⬇ Xuất tiến độ</button><button class="secondary" data-action="import">⬆ Nhập tiến độ</button></div><div class="helper" style="margin-top:12px">Chỉ các câu trả lời đúng trong phần Kiểm tra mới được cộng vào mốc 5/5. Dữ liệu cũ vẫn giữ kết quả bài kiểm tra, nhưng không thể tính lại số lần đúng cho từng từ từ phiên bản trước. Nên xuất bản sao khi đổi máy.</div></div></div>`;
}
function renderLearn(){const arr=lessonWords(),w=currentWord();if(!w)return `<div class="empty">Không có từ để học.</div>`;return `${headerHTML('Học từ vựng từng bước','Nghe phát âm, đọc theo rồi luyện kiểm tra. Từ chỉ được tự động tính “Đã thuộc” sau 5 lượt trả lời đúng.')}${stripHTML()}<div class="stage"><div><div class="study-card"><div class="word-num">TỪ ${state.card+1}/${arr.length} TRONG BÀI</div><div class="bigword">${esc(w.en)}</div><div class="ipa">${esc(w.ipa||'Chưa có phiên âm trong Excel')}</div><button class="speaker" data-speak="${w.id}">🔊 Nghe phát âm</button><div class="meaning">${esc(w.vi||'⚠ Chưa có nghĩa trong file Excel')}</div><span class="pos">${esc(displayPOS(w.pos))}</span><div style="margin-top:15px">${statusPill(w)}</div>${masteryHTML(w)}<div class="card-bottom"><button class="mark-review ${getStatus(w)==='review'?'chosen':''}" data-mark="review" data-id="${w.id}">↻ ${getStatus(w)==='review'?'Bỏ đánh dấu cần ôn':'Cần ôn lại'}</button><button class="primary" data-view="quiz">✍️ Luyện để đạt 5/5 →</button></div></div><div class="flash-controls"><button class="secondary" data-card-dir="-1" ${state.card===0?'disabled':''}>← Từ trước</button><div class="card-step">${state.lesson*10+state.card+1} / ${scopeWords().length} từ của Part</div><button class="primary" data-card-dir="1" ${state.card===arr.length-1?'disabled':''}>Từ tiếp theo →</button></div></div><div class="aside-panel">${miniStats()}${tipPanel()}<div class="panel"><h3>🧠 Sẵn sàng kiểm tra?</h3><p>Sau 10 từ, làm bài chọn nghĩa hoặc nghe rồi chọn nghĩa để ghi nhớ sâu hơn.</p><button class="soft" data-view="quiz">Làm bài kiểm tra →</button></div></div></div>`;}
function displayPOS(pos){const p=pos.trim().toLowerCase();return ({n:'Danh từ (n)',v:'Động từ (v)',adj:'Tính từ (adj)',adv:'Trạng từ (adv)',prep:'Giới từ (prep)','noun phrase':'Cụm danh từ','verb phrase':'Cụm động từ',conj:'Liên từ'}[p]||pos.trim()||'Chưa ghi loại từ');}
function renderFlashcards(){const a=lessonWords(),w=currentWord();if(!w)return `<div class="empty">Không có từ để học.</div>`;return `${headerHTML('Lật thẻ ghi nhớ','Xem mặt tiếng Anh, đoán nghĩa trong đầu, rồi bấm vào thẻ để lật mặt sau.')}${stripHTML()}<div class="tabs"><span class="tagline">THẺ ${state.card+1}/${a.length}</span>${statusPill(w)}</div><div class="mastery-summary">Trả lời đúng <b>${correctTotal(w)}/5 lần</b> để từ tự chuyển sang “Đã thuộc”.</div><div class="flashcard" data-action="flip" role="button" tabindex="0" aria-label="Lật flashcard"><div class="flash-inner">${!state.flipped?`<div class="helper">MẶT TRƯỚC · TIẾNG ANH</div><div class="flash-front">${esc(w.en)}</div><div class="ipa">${esc(w.ipa)}</div><div class="flash-hint">Chạm vào thẻ để xem nghĩa tiếng Việt</div>`:`<div class="helper">MẶT SAU · NGHĨA TIẾNG VIỆT</div><div class="flash-back">${esc(w.vi||'Chưa có nghĩa trong Excel')}</div><div style="margin-top:20px" class="pos">${esc(displayPOS(w.pos))}</div><div class="flash-hint">Chạm lần nữa để xem từ tiếng Anh</div>`}</div></div><div class="flash-controls"><div class="flash-actions"><button class="speaker" data-speak="${w.id}">🔊 Nghe từ</button><button class="mark-review ${getStatus(w)==='review'?'chosen':''}" data-mark="review" data-id="${w.id}">↻ Cần ôn</button><button class="soft" data-view="quiz">✍️ Luyện đạt 5/5</button></div><div class="flash-actions"><button class="secondary" data-card-dir="-1" ${state.card===0?'disabled':''}>← Trước</button><button class="primary" data-card-dir="1" ${state.card===a.length-1?'disabled':''}>Tiếp →</button></div></div><p class="helper" style="text-align:center;margin-top:16px">Mẹo: Nhấn phím ← / → để chuyển thẻ, phím Space để nghe phát âm.</p>`;}
const shuffle=a=>{const arr=[...a];for(let i=arr.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[arr[i],arr[j]]=[arr[j],arr[i]];}return arr;};
function initQuiz(){let pool=lessonWords().filter(w=>w.vi&&w.en);state.quiz={items:shuffle(pool),index:0,score:0,answered:false,selected:null,finished:pool.length===0,wrong:[],answerText:''};if(pool.length===0)return;state.quiz.options=createOptions(state.quiz.items[0]);}
function createOptions(w){let pool=[...scopeWords().filter(x=>x.vi&&x.vi!==w.vi),...testWords(w.test).filter(x=>x.vi&&x.vi!==w.vi),...ALL.filter(x=>x.vi&&x.vi!==w.vi)];let opts=[w.vi],seen=new Set(opts);for(const other of shuffle(pool)){if(!seen.has(other.vi)){seen.add(other.vi);opts.push(other.vi)}if(opts.length>=4)break;}return shuffle(opts);}
function renderQuiz(){if(!state.quiz)initQuiz();const q=state.quiz;const tabs=`<div class="tabs"><button class="tab ${state.quizKind==='meaning'?'active':''}" data-quiz-kind="meaning">🔤 Nhìn từ – chọn nghĩa</button><button class="tab ${state.quizKind==='listen'?'active':''}" data-quiz-kind="listen">🔊 Nghe – chọn nghĩa</button><button class="tab ${state.quizKind==='spell'?'active':''}" data-quiz-kind="spell">✍️ Gõ từ tiếng Anh</button></div>`;
  let intro=`${headerHTML('Luyện tập & kiểm tra','Mỗi câu đúng cộng 1 lượt cho từ đó; tích lũy đủ 5 lượt đúng từ cả 3 chế độ sẽ tự động đạt “Đã thuộc”. Từ làm sai sẽ được đưa vào mục “Cần ôn”.')}${stripHTML()}${tabs}`;
  if(!q.items.length)return intro+`<div class="empty"><b>Chưa có đủ từ để kiểm tra</b>Từ chưa có nghĩa tiếng Việt trong Excel sẽ được bỏ qua khi ra câu hỏi.</div>`;
  if(q.finished)return intro+`<div class="quiz-panel"><div class="finish"><div class="finish-emoji">${q.score===q.items.length?'🏆':q.score>=q.items.length*.7?'🎉':'💪'}</div><h2>${q.score>=q.items.length*.7?'Bạn làm rất tốt!':'Hoàn thành bài luyện tập!'}</h2><div class="score-big">${q.score} / ${q.items.length}</div><p class="result-msg">${q.wrong.length?`Có ${q.wrong.length} từ cần ôn lại. Hãy nghe và học thêm rồi thử lại.`:'Bạn trả lời đúng tất cả các câu hỏi trong bài này.'}</p><div class="action-row" style="justify-content:center;margin-top:26px"><button class="primary" data-action="restart-quiz">↻ Kiểm tra lại</button><button class="secondary" data-view="review">Ôn từ chưa nhớ</button><button class="secondary" data-lesson-dir="1" ${state.lesson===lessons()-1?'disabled':''}>Bài 10 từ tiếp theo →</button></div></div></div>`;
  const w=q.items[q.index],answer=q.selected===w.vi;const isSpelling=state.quizKind==='spell';
  return intro+`<div class="quiz-panel"><div class="quiz-top"><span>CÂU ${q.index+1} / ${q.items.length}</span><b>✓ ${q.score} câu đúng</b></div><div class="quiz-progress"><i style="width:${(q.index+(q.answered?1:0))/q.items.length*100}%"></i></div><div class="quiz-question">${state.quizKind==='meaning'?`<small>TỪ NÀY CÓ NGHĨA LÀ GÌ?</small><h2>${esc(w.en)}</h2><div class="ipa">${esc(w.ipa)}</div><button class="speaker" data-speak="${w.id}">🔊 Nghe cách đọc</button>`:state.quizKind==='listen'?`<small>NGHE CÁCH ĐỌC VÀ CHỌN NGHĨA ĐÚNG</small><button class="speaker" data-speak="${w.id}" style="font-size:20px;margin:20px auto">🔊 Bấm để nghe từ</button>${q.answered?`<h2 style="font-size:24px">${esc(w.en)}</h2>`:''}`:`<small>NHÌN NGHĨA TIẾNG VIỆT VÀ GÕ TỪ TIẾNG ANH</small><h2 style="font-size:27px">${esc(w.vi)}</h2><button class="speaker" data-speak="${w.id}">🔊 Nghe gợi ý</button>`}</div>
  ${isSpelling?`<form id="typingForm" autocomplete="off"><input id="typedAnswer" class="input-answer" placeholder="Gõ từ tiếng Anh vào đây…" aria-label="Gõ câu trả lời" ${q.answered?'disabled':''} value="${esc(q.answerText||'')}"><div class="quiz-bottom">${!q.answered?`<button class="primary" type="submit">Kiểm tra câu trả lời</button>`:''}</div></form>`:`<div class="answers">${q.options.map((v,i)=>`<button class="answer ${q.answered?(v===w.vi?'correct':q.selected===v?'wrong':''):''}" data-choice="${i}" ${q.answered?'disabled':''}><span class="letter">${'ABCD'[i]}</span><span>${esc(v)}</span></button>`).join('')}</div>`}
  ${q.answered?`<div class="answer-feedback ${answer||q.correctTyping?'success':'error'}">${answer||q.correctTyping?'✓ Chính xác! Làm tốt lắm.':'✗ Chưa chính xác. Hãy ghi nhớ đáp án đúng.'}<div style="font-weight:500;margin-top:4px">${esc(w.en)} — ${esc(w.vi)}</div><div class="mastery-result">${correctTotal(w)===REQUIRED_CORRECT?(q.correctTyping||answer?'🎉 Từ này đã đạt 5/5 lần đúng – ĐÃ THUỘC!':'Từ này đã đạt 5/5 trước đó, nhưng bạn vừa trả lời sai. Nên ôn lại để nhớ chắc hơn.'):`Tiến độ của từ này: ${correctTotal(w)}/5 lần trả lời đúng. ${q.correctTyping||answer?'Đã cộng 1 lượt.':'Cần luyện thêm.'}`}</div></div><div class="quiz-bottom"><button class="primary" data-action="next-question">${q.index===q.items.length-1?'Xem kết quả':'Câu tiếp theo →'}</button></div>`:''}</div>`;
}
function recordQuizAnswer(correct){const q=state.quiz;if(!q||q.answered)return;const w=q.items[q.index];q.answered=true;q.correctTyping=correct;if(correct){q.score++;creditCorrect(w.id,state.quizKind);}else{q.wrong.push(w.id);if(getStatus(w.id)!=='known')progress.statuses[w.id]='review';saved();}}
function submitTyping(){const q=state.quiz;if(!q||q.answered)return;const el=$('#typedAnswer');if(!el)return;const value=el.value.trim();if(!value){toast('Hãy gõ câu trả lời trước khi kiểm tra.');return;}q.answerText=value;const w=q.items[q.index];const normalize=x=>x.trim().toLocaleLowerCase('en').replace(/[’‘]/g,"'").replace(/\s+/g,' ').replace(/[-–]/g,'-');const correct=[w.en,cleanForSpeech(w.en)].some(x=>normalize(x)===normalize(value));q.selected=correct?w.vi:null;recordQuizAnswer(correct);render();}
function finishQuiz(){const q=state.quiz;q.finished=true;progress.results.push({date:today(),test:state.test,part:state.part,lesson:state.lesson+1,kind:state.quizKind,score:q.score,total:q.items.length});progress.results=progress.results.slice(-100);saved();}
function sourceList(){let list=state.view==='review'?ALL.filter(w=>getStatus(w)==='review'):(state.listScope==='all'?ALL:scopeWords());if(state.statusFilter!=='all'&&state.view!=='review')list=list.filter(w=>getStatus(w)===state.statusFilter);const s=state.search.trim().toLowerCase();if(s)list=list.filter(w=>[w.en,w.vi,w.ipa,w.pos,`test ${w.test}`,`part ${w.part}`].some(v=>String(v||'').toLowerCase().includes(s)));return list;}
function listBodyHTML(){const list=sourceList();const pages=Math.max(1,Math.ceil(list.length/25));state.page=Math.min(state.page,pages-1);const subset=list.slice(state.page*25,(state.page+1)*25);return `<div class="section-header" style="margin:0 0 13px"><span class="section-hint">Tìm thấy <b>${list.length}</b> mục từ ${state.view==='review'||state.listScope==='all'?'trong toàn bộ 10 đề':`ở TEST ${state.test} – PART ${state.part}`}</span><span class="section-hint">Trang ${state.page+1}/${pages}</span></div><div class="word-list">${subset.map((w,i)=>`<div class="word-row"><div class="index">${state.page*25+i+1}</div><div><strong>${esc(w.en)}</strong><span class="row-ipa">${esc(w.ipa||'—')} · <span>${esc(displayPOS(w.pos))}</span></span>${state.view==='review'||state.listScope==='all'?`<span class="helper">TEST ${w.test} / PART ${w.part}</span>`:''}</div><div class="row-meaning">${esc(w.vi||'⚠ Chưa có nghĩa trong file Excel')}<div class="mastery-inline">${statusPill(w)}</div><div class="mastery-inline">${correctTotal(w)}/5 lượt đúng</div></div><div class="row-actions"><button class="round" data-speak="${w.id}" title="Nghe cách đọc" aria-label="Nghe ${esc(w.en)}">🔊</button><button class="round ${getStatus(w)==='review'?'selected-review':''}" data-mark="review" data-id="${w.id}" title="${getStatus(w)==='review'?'Bỏ cần ôn':'Đánh dấu cần ôn'}" aria-label="Cần ôn ${esc(w.en)}">↻</button></div></div>`).join('')||`<div class="empty"><b>Chưa có từ phù hợp</b>Hãy thử tìm một từ khác hoặc chọn Part khác.</div>`}</div><div class="pagination"><button class="secondary" data-page-dir="-1" ${state.page===0?'disabled':''}>← Trước</button><span class="helper">${state.page+1} / ${pages}</span><button class="secondary" data-page-dir="1" ${state.page>=pages-1?'disabled':''}>Sau →</button></div>`;}
function renderWords(){return `${headerHTML(state.view==='review'?'Những từ cần ôn lại':'Danh sách & tra cứu từ vựng',state.view==='review'?'Tất cả từ bạn đánh dấu “Cần ôn” từ mọi Test và Part đều ở đây.':'Tra từ tiếng Anh, nghĩa tiếng Việt, phiên âm hoặc loại từ trên toàn bộ 10 đề hoặc riêng Part bạn chọn.')}${state.view==='review'?`<div class="lesson-strip"><span class="strip-info"><b>${reviewNum()} từ cần ôn</b> trong toàn bộ 10 đề.</span><button class="soft" data-view="learn">← Trở lại học</button></div>`:''}<div class="list-tools"><input id="searchInput" class="search" type="search" placeholder="🔎 Tìm từ hoặc nghĩa tiếng Việt…" value="${esc(state.search)}" aria-label="Tìm từ vựng">${state.view==='words'?`<select class="control" id="listScope" aria-label="Phạm vi tra cứu"><option value="all" ${state.listScope==='all'?'selected':''}>Toàn bộ 10 đề</option><option value="part" ${state.listScope==='part'?'selected':''}>Chỉ Part đang chọn</option></select><select class="control" id="statusFilter" aria-label="Lọc từ đã thuộc"><option value="all" ${state.statusFilter==='all'?'selected':''}>Tất cả trạng thái</option><option value="new" ${state.statusFilter==='new'?'selected':''}>Chưa học</option><option value="known" ${state.statusFilter==='known'?'selected':''}>Đã thuộc</option><option value="review" ${state.statusFilter==='review'?'selected':''}>Cần ôn</option><option value="learning" ${state.statusFilter==='learning'?'selected':''}>Đang học</option></select>`:''}</div><div id="wordResults">${listBodyHTML()}</div>`;}
function render(){const total=knownNum();$('#nav').innerHTML=navHTML();$('#sideProgress').style.width=percentage(ALL)+'%';$('#sideProgressText').textContent=`${total}/${COUNT} từ đã thuộc · ${percentage(ALL)}%`;
  $('#topTitle').textContent=state.view==='review'?'Ôn tập toàn bộ':'Khóa học từ vựng TOEIC';$('#topSubtitle').textContent=state.view==='review'?`${reviewNum()} từ cần ôn · tất cả 10 đề`:`Đang chọn TEST ${state.test} · PART ${state.part} · ${scopeWords().length} từ`;
  $('#testSelect').value=String(state.test);$('#partSelect').value=String(state.part);$('#voiceSelect').value=prefs.voice;$('#speedSelect').value=String(prefs.speed);
